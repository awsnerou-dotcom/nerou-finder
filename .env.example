# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: Managed PostgreSQL database connection URL for production.
# AI Studio automatically loads this from user secrets at runtime.
# Example: postgresql://username:password@host:port/database?schema=public
DATABASE_URL="postgresql://username:password@localhost:5432/nerou_db?schema=public"

# DIRECT_URL: Direct (non-pooled) Postgres connection, required by Prisma for
# schema migrations when DATABASE_URL points at a connection pooler (e.g. Supabase).
DIRECT_URL="postgresql://username:password@localhost:5432/nerou_db?schema=public"

# JWT_SECRET: Signs/verifies login session tokens. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="REPLACE_WITH_RANDOM_64_CHAR_HEX_STRING"

# RESEND_API_KEY: Optional. Powers real outbound email delivery (document review
# notices, team invitations, subscription/billing notices) via https://resend.com.
# Every email is always logged locally (visible in Control Center > Email Logs)
# regardless of whether this is set; without it, no real email is sent.
RESEND_API_KEY=""

# EMAIL_FROM: Optional. The "from" address used for real email delivery.
# Defaults to Resend's shared sandbox sender, which can only deliver to the
# Resend account owner's own address until a custom domain is verified.
EMAIL_FROM="Nerou Finder <onboarding@resend.dev>"


